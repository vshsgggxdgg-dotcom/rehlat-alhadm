# ============================================================================
# رحلة الهضم (Digestion Journey) — Environment Variable Template
# ============================================================================
# SECURITY RULE:
# Never place private API keys, database credentials, or server secrets (such
# as SUPABASE_SERVICE_ROLE_KEY or SUPABASE_DB_URL) in any variable prefixed
# with VITE_ or in any file committed to Git. Variables prefixed with VITE_
# are exposed to the browser bundle at build time.
# Copy this file to `.env.local` for local overrides.
# ============================================================================

# Operating Mode: "demo" | "production"
VITE_APP_MODE=demo

# Authoritative Published Curriculum Content Version Identifier (Stable ID)
VITE_CONTENT_VERSION=content-ar-g6-digestion-v1.4.0

# Browser-Safe Supabase Configuration for Production Anonymous Auth & RLS
# Use ONLY the public publishable / anon key in browser variables; NEVER service_role!
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Optional: Cloudflare Turnstile Site Key for Anonymous Sign-In Abuse Protection
VITE_SUPABASE_CAPTCHA_SITE_KEY=

# Optional REST Backend API Base URL
VITE_API_BASE_URL=

# Optional: Enable technical diagnostics panel ("true" | "false")
VITE_ENABLE_DIAGNOSTICS=true

# Optional: Configurable developer attribution shown in the About screen.
# Leave empty if not specified; never invent a developer name.
VITE_DEVELOPER_ATTRIBUTION=

# Optional: Local administrator passcode for the protected Admin Area (Demo Mode only)
VITE_ADMIN_PASSCODE=

# ============================================================================
# SERVER-ONLY CREDENTIALS (Edge Functions / CLI / Migrations ONLY — NO VITE_ prefix!)
# ============================================================================
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_AUTH_CAPTCHA_SECRET=
